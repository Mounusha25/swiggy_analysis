  "description": "Tracks revenue and order volume month over month to identify seasonality patterns and improve sales forecasting.",
  "sql": "SELECT\n    Year_Month                           AS \"Month\",\n    COUNT(*)                             AS \"Orders\",\n    ROUND(SUM(\"Price (INR)\"), 2)         AS \"Revenue (INR)\",\n    ROUND(AVG(\"Price (INR)\"), 2)         AS \"Avg Order Value (INR)\",\n    ROUND(AVG(Rating), 3)                AS \"Avg Rating\"\nFROM orders\nGROUP BY Year_Month\nORDER BY Year_Month;",
