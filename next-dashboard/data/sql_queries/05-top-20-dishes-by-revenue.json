  "name": "Top 20 Dishes by Revenue",
  "slug": "top-20-dishes-by-revenue",
  "description": "Identifies highest-revenue dishes to inform menu optimisation, promotions, and restaurant partnership decisions.",
  "sql": "SELECT\n    \"Dish Name\"                          AS \"Dish\",\n    COUNT(*)                             AS \"Orders\",\n    ROUND(SUM(\"Price (INR)\"), 2)         AS \"Revenue (INR)\",\n    ROUND(AVG(\"Price (INR)\"), 2)         AS \"Avg Price (INR)\",\n    ROUND(AVG(Rating), 2)                AS \"Avg Rating\"\nFROM orders\nGROUP BY \"Dish Name\"\nORDER BY \"Revenue (INR)\" DESC\nLIMIT 20;",
