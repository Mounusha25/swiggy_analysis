{
  "name": "Revenue by Food Category",
  "slug": "revenue-by-food-category",
  "description": "Breaks down revenue by cuisine category to reveal high-value food segments and guide menu strategy.",
  "sql": "SELECT\n    Category                             AS \"Food Category\",\n    COUNT(*)                             AS \"Orders\",\n    ROUND(SUM(\"Price (INR)\"), 2)         AS \"Revenue (INR)\",\n    ROUND(AVG(\"Price (INR)\"), 2)         AS \"Avg Order Value (INR)\",\n    ROUND(AVG(Rating), 3)                AS \"Avg Rating\"\nFROM orders\nGROUP BY Category\nORDER BY \"Revenue (INR)\" DESC\nLIMIT 20;",
